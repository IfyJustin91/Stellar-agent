#!/usr/bin/env sh
set -eu

for candidate in "$HOME/.cargo/env" "/usr/local/cargo/env" "/root/.cargo/env"; do
  if [ -f "$candidate" ]; then
    . "$candidate"
    break
  fi
done

if [ -d "$HOME/.cargo/bin" ]; then
  export PATH="$HOME/.cargo/bin:$PATH"
fi

echo "Checking Rust formatting..."
cargo fmt --all -- --check || {
  echo "Rust formatting failed. Run 'cargo fmt --all' and stage the formatted files."
  exit 1
}

echo "Running Rust clippy..."
cargo clippy --quiet --workspace --all-targets --all-features -- -D warnings || {
  echo "Clippy failed. Fix the reported warnings before committing."
  exit 1
}

echo "Checking staged files..."
npm exec -- lint-staged
